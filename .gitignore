# Frontend (Node / SvelteKit)
**/node_modules/
apps/frontend/.svelte-kit/
apps/frontend/build/
apps/frontend/.env
apps/frontend/.env.*
!apps/frontend/.env.example

# Backend (.NET)
**/bin/
**/obj/
apps/services/**/*.db
apps/services/**/*.db-shm
apps/services/**/*.db-wal
apps/services/**/*.lscache
apps/services/**/.env

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.user
.claude/*
!.claude/skills/
!.claude/hooks/
!.claude/settings.json
!.claude/launch.json
.vs/
# Compose .env (deployed-host settings)
/infra/.env
# Dozzle's login and saved settings (infra/deploy/dozzle-user.sh)
/infra/dozzle/*
!/infra/dozzle/.gitkeep
# Pre-infra/ locations, so files a checkout hasn't moved yet stay out of commits
/.env
/dozzle/
/src/
/frontend/
/renderer/
