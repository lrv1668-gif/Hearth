# Root .env — read by Docker Compose for variable substitution in
# docker-compose.yml (service secrets live in src/<Service>/.env instead).
# Copy to .env on a deployed host; local development needs none of this.

# Where to pull images from. CI publishes ghcr.io/<github-owner>/hearth-<service>.
HEARTH_IMAGE_PREFIX=ghcr.io/<github-owner>/hearth
# latest, or sha-<short commit> to pin a specific build
HEARTH_TAG=latest

# The host's own name; Caddy serves https://<HEARTH_HOST> with its local CA
HEARTH_HOST=hearth.local
# The address people open Hearth at; OAuth flows redirect back here
FRONTEND_URL=https://hearth.local

# Optional live container logs at /logs (Dozzle), linked from Settings → Diagnostics.
# Off by default: it reads the Docker socket. Uncomment, then set its login with
# deploy/dozzle-user.sh <name>.
# COMPOSE_PROFILES=logs

# Optional fallback IANA time zone for the e-paper frame's date and clock (e.g.
# America/Chicago), used until one is saved in Settings → Home. The renderer's headless
# browser otherwise runs on UTC.
TZ=
