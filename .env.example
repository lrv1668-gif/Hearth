# Stack-wide configuration, read by docker-compose.yml / docker-compose.ghcr.yml.
# Copy to .env and adjust for a production deployment; both values are optional
# for localhost/LAN use and default to sensible values below.

# Public URL the frontend is served at. Used by Spotify and Google Calendar to
# build OAuth callback URLs. If you set this to a real domain, you must also
# update SPOTIFY_REDIRECT_URI (src/Spotify/.env) and GOOGLE_REDIRECT_URI
# (src/Calendar/.env) to match, and re-register that exact callback URL in the
# Spotify Developer dashboard and Google Cloud OAuth console.
FRONTEND_URL=http://localhost

# Image tag used by docker-compose.ghcr.yml. See release tags at
# https://github.com/lrv1668-gif/Hearth/pkgs/container/hearth-tasks
HEARTH_VERSION=latest
