# Optional fallback location for the daylight section (trend, drift, milestones) —
# Settings → Home sets it for every service, and wins when saved. With neither, /almanac
# still works but omits daylight. Find coordinates at https://www.latlong.net or similar.
LATITUDE=
LONGITUDE=

# Optional fallback IANA time zone for wall-clock milestones (e.g. America/Chicago), used
# until one is saved in Settings → Home. Defaults to the container/system zone.
TZ=

# Optional typical frost dates for your area, as MM-DD (e.g. 10-15 and 04-20).
# When unset, /almanac omits the frost section.
FIRST_FROST=
LAST_FROST=
