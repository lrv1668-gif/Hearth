# Get an Unsplash key by going here and creating an account/ app: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Optional fallback latitude — only its sign matters (southern hemisphere flips the seasonal
# photo queries). Settings → Home sets it for every service, and wins when saved.
# Running outside Docker? Set DISPLAY_URL=http://localhost:8090 to read the saved location.
LATITUDE=
