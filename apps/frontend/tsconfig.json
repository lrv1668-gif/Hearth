{
    "extends": "$app/tsconfig",
    "include": ["src", "test", "*"],
    "exclude": ["src/service-worker"],
    "compilerOptions": {
        "types": ["node", "$app/types"],
        "allowJs": true,
        "checkJs": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "allowImportingTsExtensions": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    }
}
