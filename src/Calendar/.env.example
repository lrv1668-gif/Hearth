# Create an OAuth client on Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Application type: Web application. Add GOOGLE_REDIRECT_URI below as an
# Authorized redirect URI — it must match exactly (including scheme and path).
# You'll also need to enable the Google Calendar API for the project and add
# your Google account as a test user if the OAuth consent screen is unpublished.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/calendar/google/callback
