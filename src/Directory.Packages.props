<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="DotNetEnv" Version="3.2.0" />
    <PackageVersion Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageVersion Include="Google.Apis.Calendar.v3" Version="1.75.0.4206" />
    <PackageVersion Include="Google.Apis.Tasks.v1" Version="1.74.0.3958" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <!-- Explicit override: Microsoft.Data.Sqlite floors this at 2.1.11, which has a
         known high-severity vulnerability (GHSA-2m69-gcr7-jv3q) -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="SkiaSharp" Version="4.151.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" />
    <PackageVersion Include="SpotifyAPI.Web" Version="7.4.2" />
  </ItemGroup>
</Project>
