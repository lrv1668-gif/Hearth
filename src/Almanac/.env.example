# Almanac service location — used for the daylight section (trend, drift, milestones).
# When unset, /almanac still works but omits daylight.
# Find your coordinates at https://www.latlong.net or similar
LATITUDE=
LONGITUDE=

# Optional IANA time zone for wall-clock milestones (e.g. America/Chicago).
# Defaults to the container/system zone when unset.
TZ=

# Optional typical frost dates for your area, as MM-DD (e.g. 10-15 and 04-20).
# When unset, /almanac omits the frost section.
FIRST_FROST=
LAST_FROST=
