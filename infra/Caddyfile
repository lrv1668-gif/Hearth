{
    # Keep plain HTTP working for the HTTPS host too: LAN clients like the frame
    # don't trust Caddy's local CA
    auto_https disable_redirects
}

# Routes shared by the plain-HTTP and HTTPS sites below
(hearth) {
    # Text responses only (HTML, JS, CSS, JSON) — Caddy's default matcher leaves
    # images like the frame PNG alone, so its ETag is untouched. Not Dozzle, which
    # streams its logs
    @compress not path /logs*
    encode @compress zstd gzip

    # Hearth has no login, so a page on another site must not be able to change things here.
    # Browsers preflight JSON writes (and no service allows them), but not a form post or a
    # body-less POST — photo uploads, the frame's mode and palette buttons. Browsers label
    # every request with where it came from; the frame client and curl send no such header.
    @crossSiteWrite {
        not method GET HEAD OPTIONS
        header Sec-Fetch-Site cross-site
    }
    # A rewrite, because it runs before every handle below; a respond here would sort after them
    rewrite @crossSiteWrite /cross-site-blocked
    handle /cross-site-blocked {
        respond "cross-site requests are not allowed" 403
    }

    handle /tasks* {
        reverse_proxy tasks:8081
    }
    handle /spotify* {
        reverse_proxy spotify:8083
    }
    handle /weather* {
        reverse_proxy weather:8082
    }
    handle /photos* {
        reverse_proxy photos:8084
    }
    handle /rss* {
        reverse_proxy rss:8085
    }
    handle /calendar/google* {
        reverse_proxy calendar:8087
    }
    handle /calendar/items* {
        reverse_proxy calendar:8087
    }
    handle /calendar/ics* {
        reverse_proxy calendar:8087
    }
    handle /calendar/health {
        reverse_proxy calendar:8087
    }
    handle /quote* {
        reverse_proxy quote:8086
    }
    handle /history* {
        reverse_proxy history:8095
    }
    handle /birds* {
        reverse_proxy birds:8088
    }
    handle /almanac* {
        reverse_proxy almanac:8089
    }
    handle /trains* {
        reverse_proxy trains:8091
    }
    handle /sports* {
        reverse_proxy sports:8094
    }
    handle /display* {
        reverse_proxy display:8090
    }
    # Dozzle's live container logs, behind its own login (infra/dozzle/users.yml)
    handle /logs* {
        reverse_proxy dozzle:8080
    }
    handle {
        reverse_proxy frontend:3000
    }
}

# Plain HTTP on any hostname — local dev, and LAN clients like the frame that
# don't need TLS
:80 {
    import hearth
}

# HTTPS for the host's own name (HEARTH_HOST in infra/.env; localhost when
# unset), signed by Caddy's local CA. OAuth providers like Spotify require an
# https redirect URI for anything but loopback.
{$HEARTH_HOST:localhost} {
    tls internal
    import hearth
}
